"""
This file is a template for the .env file.

Please copy this file to .env and fill in the values.

For more information about configuration options, please refer to the documentation

"""

# ==========================================
# Global configs:
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
# ==========================================


# ==========================================
# Backend Configuration
# ==========================================
# BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# ==========================================

# ==========================================
# Backend Configuration (choose one)
# ==========================================

# 1. Set universal API key
# CHAT_MODEL="gpt-4o"
# EMBEDDING_MODEL="text-embedding-3-small"
# OPENAI_API_BASE="https://your-endpoint.com/v1"
# OPENAI_API_KEY="sk-your-api-key-here"

# 2. Set separate API KEY
# Chat configuration
OPENAI_API_KEY="sk-chat-key"
OPENAI_API_BASE="https://xxx-litellm.com/v1"
CHAT_MODEL='gpt-4o'

# Embedding configuration (using other service)
# Use siliconflow as example, pay attention to the litellm_proxy prefix
LITELLM_PROXY_API_KEY="sk-embedding-service-key"
LITELLM_PROXY_API_BASE="https://api.siliconflow.cn/v1"
EMBEDDING_MODEL="litellm_proxy/BAAI/bge-large-en-v1.5"
# ==========================================

# ==========================================
# Other Configuration 
# ==========================================
# CHAT_AZURE_API_BASE=<for_Azure_user>
# CHAT_AZURE_API_VERSION=<for_Azure_user>

# EMBEDDING_AZURE_API_BASE=<for_Azure_user>
# EMBEDDING_AZURE_API_VERSION=<for_Azure_user>

# Cache Setting (Optional):
# USE_CHAT_CACHE=True
# USE_EMBEDDING_CACHE=True
# FT_DOCKER_ENABLE_CACHE=True
# DS_DOCKER_ENABLE_CACHE=True
# Run generated model implementations in the Qlib Docker image. This is the
# recommended setting when Conda and the rdagent4qlib environment are absent.
MODEL_COSTEER_ENV_TYPE=docker
# Reuse the verified local image instead of rebuilding it for every evaluation.
QLIB_DOCKER_BUILD_FROM_DOCKERFILE=false
# Senario Configs:
# ==========================================
# Chronological research split for the bundled 2026-10-16 CN dataset.
# The one-day label needs two future trading days, so 2026-10-14 is the
# latest fully labelled date. The framework adaptively selects experiments on
# the test segment; treat it as a research-selection period, not a final holdout.
QLIB_FACTOR_TRAIN_START=2010-01-01
QLIB_FACTOR_TRAIN_END=2020-12-31
QLIB_FACTOR_VALID_START=2021-01-01
QLIB_FACTOR_VALID_END=2022-12-31
QLIB_FACTOR_TEST_START=2023-01-01
QLIB_FACTOR_TEST_END=2026-10-14
QLIB_FACTOR_MARKET=csi500
QLIB_FACTOR_BENCHMARK=SH000905
QLIB_MODEL_TRAIN_START=2010-01-01
QLIB_MODEL_TRAIN_END=2020-12-31
QLIB_MODEL_VALID_START=2021-01-01
QLIB_MODEL_VALID_END=2022-12-31
QLIB_MODEL_TEST_START=2023-01-01
QLIB_MODEL_TEST_END=2026-10-14
QLIB_MODEL_MARKET=csi500
QLIB_MODEL_BENCHMARK=SH000905
QLIB_QUANT_TRAIN_START=2010-01-01
QLIB_QUANT_TRAIN_END=2020-12-31
QLIB_QUANT_VALID_START=2021-01-01
QLIB_QUANT_VALID_END=2022-12-31
QLIB_QUANT_TEST_START=2023-01-01
QLIB_QUANT_TEST_END=2026-10-14
QLIB_QUANT_MARKET=csi500
QLIB_QUANT_BENCHMARK=SH000905

# ==========================================
# Langfuse observability (optional)
# ==========================================
# Tracing is opt-in. Create project keys in Langfuse and keep real secrets in
# your untracked .env file only.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY="pk-lf-replace-me"
LANGFUSE_SECRET_KEY="sk-lf-replace-me"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_OTEL_HOST="https://us.cloud.langfuse.com"
LANGFUSE_TRACING_ENVIRONMENT="development"
LANGFUSE_SAMPLE_RATE=1.0
# Safe production default: prompts, responses, hypotheses, and factor formulas
# are not exported. Enable only for sanitized development runs.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_LINK_PROMPTS=true
# ==========================================
